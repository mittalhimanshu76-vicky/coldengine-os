        "jsCode": "return [\n  { json: { company: \"Linear\", domain: \"linear.app\" } },\n  { json: { company: \"Vercel\", domain: \"vercel.com\" } },\n  { json: { company: \"Dead Example\", domain: \"nonexistent-domain-coldengine-test.xyz\" } }\n];"
