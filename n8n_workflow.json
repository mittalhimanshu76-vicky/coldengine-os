          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.Status }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "cond-2",
              "leftValue": "={{ Boolean($json.Answer && $json.Answer.length > 0) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
